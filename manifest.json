{
  "manifest_version": 2,
  "name": "Gitlab-Export",
  "version": "1.0",

  "description": "Permet d'exporter une issue Gitlab sous format JSON.",

  "icons": {
    "48": "icons/icon-48.svg"
  },

  "permissions": ["activeTab", "*://gitlab.com/*", "downloads"],

  "browser_action": {
    "default_icon": "icons/icon-48.svg",
    "default_title": "Coucou",
    "default_popup": "menu/menu.html"
  }
}